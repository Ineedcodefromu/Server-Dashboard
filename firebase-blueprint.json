{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, preferences and association",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "user"] },
        "groupId": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string", "enum": ["light", "dark", "system"], "default": "dark" },
        "accentColor": { "type": "string", "enum": ["blue", "purple", "emerald", "amber", "rose", "indigo"], "default": "blue" },
        "notifications": {
          "type": "object",
          "properties": {
            "system": { "type": "boolean" },
            "trading": { "type": "boolean" },
            "security": { "type": "boolean" },
            "email": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Project tracking entity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "active", "paused", "completed"] },
        "progress": { "type": "number" },
        "notes": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CodeSnippet": {
      "title": "Code Snippet",
      "description": "Stored code examples and notes",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "code": { "type": "string" },
        "language": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "Log": {
      "title": "System Log",
      "description": "Audit trail for system events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] }
      }
    },
    "Task": {
      "title": "Kanban Task",
      "description": "Task for kanban board",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "checklist": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read"]
    },
    "Document": {
      "title": "Document",
      "description": "Stored document metadata with storage paths",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "url"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "Metadata for an AI chat session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sessionId", "role", "content"]
    },
    "GlobalMessage": {
      "title": "Global Message",
      "description": "Messages in the team chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content"]
    },
    "DirectMessage": {
      "title": "Direct Message",
      "description": "Private message between two users",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "recipientId", "content", "participants"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Project or category budget",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "spent": { "type": "number" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "amount"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Individual project expense",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "budgetId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" }
      },
      "required": ["userId", "budgetId", "title", "amount"]
    },
    "StockWatchlist": {
      "title": "Stock Watchlist",
      "description": "User specific stock tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "symbols": { "type": "array", "items": { "type": "string" } }
      }
    },
    "UserGroup": {
      "title": "User Group",
      "description": "Group of users with shared permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user accounts"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Shared or private projects"
    },
    "/snippets/{snippetId}": {
      "schema": "CodeSnippet",
      "description": "Shared or private code snippets"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Global system logs"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "User specific kanban tasks"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "User documents"
    },
    "/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User chat sessions"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in a chat"
    },
    "/global_messages/{messageId}": {
      "schema": "GlobalMessage",
      "description": "Messages in the team-wide chat"
    },
    "/direct_messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Private direct messages"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Project budgets"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Project expenses"
    },
    "/watchlists/{userId}": {
      "schema": "StockWatchlist",
      "description": "User stock watchlists"
    },
    "/user_groups/{groupId}": {
      "schema": "UserGroup",
      "description": "Shared user groups"
    }
  }
}
