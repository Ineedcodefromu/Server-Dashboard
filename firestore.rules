rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function hasRole(role) {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == role;
    }

    function isOwnerRole() {
      return isSignedIn() && (
        request.auth.token.email == 'mathewsniko02@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'owner')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mathewsniko02@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'owner' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasPermission(perm) {
      return isSignedIn() && (
        request.auth.token.email == 'mathewsniko02@gmail.com' || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'owner' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', []).hasAny([perm]) || (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groupId', null) != null &&
              exists(/databases/$(database)/documents/user_groups/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId)) &&
              get(/databases/$(database)/documents/user_groups/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId)).data.get('permissions', []).hasAny([perm])
            )
          )
        )
      );
    }

    function isValidUserGroup(data) {
      return data.get('name', '') is string && data.get('name', '').size() > 0 && data.get('name', '').size() <= 100
        && data.get('permissions', []) is list
        && (data.get('description', null) == null || data.get('description', '') is string);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role']) 
        && data.get('uid', '') == request.auth.uid 
        && data.get('role', '') in ['owner', 'admin', 'user']
        && (data.get('email', null) == null || data.get('email', '') is string);
    }

    function isValidProject(data) {
      return data.get('title', '') is string && data.get('title', '').size() > 0 && data.get('title', '').size() <= 200;
    }

    function isValidTask(data) {
      return data.get('title', '') is string && data.get('title', '').size() > 0 && data.get('title', '').size() <= 200
        && data.get('status', 'todo') in ['todo', 'in-progress', 'done']
        && data.get('userId', '') is string;
    }

    function isValidNotification(data) {
      return data.get('title', '') is string && data.get('title', '').size() > 0
        && data.get('userId', '') == request.auth.uid
        && data.get('read', false) is bool;
    }

    function isValidDocument(data) {
      return data.get('name', '') is string && data.get('name', '').size() > 0
        && data.get('userId', '') == request.auth.uid;
    }

    function isValidChatSession(data) {
      return data.get('title', '') is string && data.get('title', '').size() > 0 && data.get('title', '').size() <= 600
        && (data.get('userId', '') == request.auth.uid);
    }

    function isValidChatMessage(data) {
      return data.get('role', 'user') in ['user', 'model']
        && data.get('content', '') is string && data.get('content', '').size() > 0 && data.get('content', '').size() <= 11000
        && (data.get('userId', '') == request.auth.uid);
    }

    function isValidGlobalMessage(data) {
      return data.get('content', '') is string && data.get('content', '').size() > 0;
    }

    function isValidDirectMessage(data) {
      return data.get('content', '') is string && data.get('content', '').size() > 0
        && data.get('participants', []) is list
        && data.get('participants', []).size() == 2
        && request.auth.uid in data.get('participants', []);
    }

    function isValidBudget(data) {
      let amount = data.get('amount', 0);
      return data.get('name', '') is string && (amount is int || amount is float);
    }

    function isValidExpense(data) {
      let amount = data.get('amount', 0);
      return data.get('description', '') is string && (amount is int || amount is float);
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || hasPermission('users.manage'));
      allow list: if hasPermission('users.manage');
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'watchlist', 'newsFeeds', 'theme', 'accentColor', 'notifications', 'lastActive', 'dashboardLayout', 'groupId', 'permissions'])) ||
        (isOwnerRole()) || // Super owner can update anyone
        (hasPermission('users.manage') && resource.data.get('role', 'user') != 'owner' && request.resource.data.get('role', 'user') != 'owner' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'groupId', 'permissions']))
      );
      allow delete: if isOwnerRole(); // Only owner can delete users
    }

    match /user_groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || hasPermission('users.manage')) && isValidUserGroup(request.resource.data);
      allow delete: if (isAdmin() || hasPermission('users.manage')) && !resource.data.get('isSystem', false);
    }

    match /global_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidGlobalMessage(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /direct_messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidDirectMessage(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    match /budgets/{budgetId} {
      allow read, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() || hasPermission('budget.view');
      allow create: if isSignedIn() && isValidBudget(request.resource.data);
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() || hasPermission('budget.view');
    }

    match /expenses/{expenseId} {
      allow read, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() || hasPermission('budget.view');
      allow create: if isSignedIn() && isValidExpense(request.resource.data);
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() || hasPermission('budget.view');
    }

    match /projects/{projectId} {
      allow read: if hasPermission('dashboard.view') || hasPermission('projects.view');
      allow create, update: if hasPermission('projects.edit') && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /snippets/{snippetId} {
      allow read: if hasPermission('dashboard.view') || hasPermission('code.view');
      allow create, update, delete: if hasPermission('code.edit');
    }

    match /logs/{logId} {
      allow read: if hasPermission('logs.view');
      allow create: if isSignedIn(); // Any signed in user can trigger a log entry
    }

    match /watchlists/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidNotification(request.resource.data);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidNotification(request.resource.data);
    }

    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidDocument(request.resource.data);
    }

    match /chat_sessions/{sessionId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidChatSession(request.resource.data);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidChatSession(request.resource.data);
    }

    match /chat_messages/{messageId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidChatMessage(request.resource.data);
    }
  }
}
